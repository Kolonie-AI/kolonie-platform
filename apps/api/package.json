{
  "name": "@kolonie-ai/api",
  "version": "0.1.0",
  "private": true,
  "description": "Public HTTP API and MCP server of the Kolonie AI platform",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/server.js",
    "dev": "node --watch dist/server.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@kolonie-ai/core": "*",
    "@kolonie-ai/db": "*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "fastify": "^5.10.0",
    "zod": "^4.4.3"
  }
}
