{
  "name": "kolonie-platform",
  "version": "0.0.0",
  "private": true,
  "description": "Kolonie AI platform monorepo — domain model, API, MCP, task engine, academy verifiers, coins ledger",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kolonie-AI/kolonie-platform.git"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "barrel": "node packages/db/scripts/generate-storage-barrel.mjs",
    "build": "npm run barrel && tsc -b",
    "clean": "tsc -b --clean && npm run clean --workspaces --if-present",
    "typecheck": "node scripts/run-workspace-script.mjs typecheck",
    "test": "node scripts/run-workspace-script.mjs test",
    "check:dist": "node scripts/check-dist.mjs",
    "test:scripts": "vitest run",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "test:db:up": "bash packages/db/scripts/start-test-database.sh",
    "test:db:relax": "node packages/db/scripts/relax-test-durability.mjs",
    "lint": "node scripts/cached-lint.mjs eslint",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "node scripts/cached-lint.mjs prettier",
    "check": "npm run check:lock && npm run gates:tree && npm run build && npm run gates:built && npm run test",
    "check:fast": "npm run check:lock && npm run gates:tree && npm run build && npm run gates:built && echo \"\" && echo \"check:fast finished. NO TESTS WERE RUN — this checked formatting, lint, build, migrations and types only. Run npm run check before you push.\"",
    "check:affected": "node scripts/check-affected.mjs",
    "gates:tree": "node scripts/run-gates.mjs format:check lint check:fixtures check:changelog check:union-guards",
    "gates:built": "node scripts/run-gates.mjs check:dist check:catalogue-floor check:migrations typecheck",
    "check:lock": "node scripts/check-lock.mjs",
    "check:migrations": "bash packages/db/scripts/check-migrations.sh",
    "check:counts": "node scripts/check-counts.mjs",
    "check:fixtures": "node scripts/check-fixture-mirrors.mjs",
    "changelog": "node scripts/build-changelog.mjs",
    "check:changelog": "node scripts/build-changelog.mjs --check",
    "check:union-guards": "node scripts/check-union-merge-guards.mjs",
    "check:catalogue-floor": "node scripts/check-catalogue-floor.mjs",
    "catalogue-budget": "node scripts/check-catalogue-budget.mjs",
    "catalogue-structure": "node scripts/write-catalogue-structure.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "ajv": "^8.20.0",
    "eslint": "^10.8.1",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  }
}
