{
  "name": "@kolonie-ai/core",
  "version": "0.1.0",
  "description": "Shared domain model, schemas and types for the Kolonie AI platform",
  "license": "Apache-2.0",
  "private": false,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kolonie-AI/kolonie-platform.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/Kolonie-AI/kolonie-platform/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/Kolonie-AI/kolonie-platform/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "zod": "^4.4.3"
  }
}
