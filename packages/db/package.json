{
  "name": "@kolonie-ai/db",
  "version": "0.1.0",
  "private": true,
  "description": "Persistence for the Kolonie AI platform \u2014 Drizzle schema, SQL migrations, connection",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "generate": "drizzle-kit generate",
    "migrate": "node dist/migrate.js",
    "check:drift": "node dist/check-migration-drift.js",
    "seed": "node dist/seed.js",
    "admin": "node dist/admin.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "pregenerate": "npm run build -w @kolonie-ai/core"
  },
  "dependencies": {
    "@kolonie-ai/core": "*",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.7"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.6"
  }
}
